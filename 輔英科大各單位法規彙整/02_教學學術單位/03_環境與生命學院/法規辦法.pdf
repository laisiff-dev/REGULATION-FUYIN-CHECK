<script>
function popChkLogin(){
	if(typeof(loginStat)=='undefined') {
   	var chkstat=0;
      var chkUrl='/app/index.php?Action=mobilelogin';
      var chkData = {Op:'chklogin'};
      var chkObj=$.hajaxReturn(chkUrl,chkData);
   	chkstat=chkObj.stat;
		if(chkstat) {
			loginStat="login"; 
			return true;
		}else {
			loginStat="logout"; 
			return false;
		}	
	}else {
		if(loginStat=="login") return true;
		else return false;
	}
}

</script>
